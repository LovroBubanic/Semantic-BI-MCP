# OpenAI — required for the chat agent
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Bearer token clients must send to the MCP server
# Generate with: openssl rand -hex 32  (or any secure random string)
MCP_API_KEY=your-secret-mcp-api-key-here

# Public MCP endpoint URL (for external clients: Cursor, MCP Inspector)
# Local dev:  http://localhost:3000/api/mcp
# Production: https://your-domain.com/api/mcp  (https, no trailing slash)
# The chat UI uses in-process MCP and does not call this URL.
MCP_URL=http://localhost:3000/api/mcp

# Optional: auto-added to MCP client headers when set (Vercel Deployment Protection bypass)
# VERCEL_AUTOMATION_BYPASS_SECRET=
