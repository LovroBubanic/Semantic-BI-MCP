# OpenAI — required for the chat agent
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Bearer token clients must send to the MCP server
# Generate with: openssl rand -hex 32  (or any secure random string)
MCP_API_KEY=your-secret-mcp-api-key-here

# URL of the deployed MCP endpoint (for external MCP clients e.g. Cursor)
# Local dev:  http://localhost:3000/api/mcp
# Production: https://your-domain.com/api/mcp  (must use https, no trailing slash)
# On Vercel the chat agent auto-uses the deployment HTTPS URL for same-app calls.
MCP_URL=http://localhost:3000/api/mcp
